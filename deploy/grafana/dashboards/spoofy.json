{
  "uid": "spoofy-overview",
  "title": "Spoofy — synthetic traffic",
  "description": "What Spoofy is sending and what the target is doing with it.",
  "tags": ["spoofy", "traffic"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "path",
        "label": "Endpoint",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
        "query": "label_values(spoofy_requests_total, path)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Target",
      "description": "Whether the API is answering at all. Independent of HTTP errors: a 500 still means the target is up.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "spoofy_target_up",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#E02F44", "value": null },
              { "color": "#56A64B", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request rate",
      "description": "Requests per second Spoofy is actually completing, averaged over the last minute.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(spoofy_requests_total[1m]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#5794F2", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failure rate",
      "description": "Share of requests that were 5xx or a transport error. 4xx is excluded — a 404 from a generated id is expected, not a fault.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(spoofy_requests_total{class=~\"5xx|error\"}[5m])) / clamp_min(sum(rate(spoofy_requests_total[5m])), 0.001)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#56A64B", "value": null },
              { "color": "#F2CC0C", "value": 1 },
              { "color": "#E02F44", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile response time as observed by Spoofy, across all endpoints.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(spoofy_request_duration_seconds_bucket[5m])) by (le))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "fixed", "fixedColor": "#C4DBFF" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#C4DBFF", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Requests sent",
      "description": "Total since this Spoofy process started.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(spoofy_requests_total)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests by status class",
      "description": "Stacked so the total is the request rate. Colours are pinned to the class name, so a class disappearing never recolours the others.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (rate(spoofy_requests_total{path=~\"$path\"}[1m]))",
          "legendFormat": "{{class}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 22,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" },
            "gradientMode": "none",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "2xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56A64B" } }]
          },
          {
            "matcher": { "id": "byName", "options": "3xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }]
          },
          {
            "matcher": { "id": "byName", "options": "4xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2CC0C" } }]
          },
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E02F44" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } }]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "One measure at three magnitudes, so one hue at three steps — brightest is worst. Both series share the same axis; a second y-scale would make the comparison meaningless.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(spoofy_request_duration_seconds_bucket{path=~\"$path\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(spoofy_request_duration_seconds_bucket{path=~\"$path\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(spoofy_request_duration_seconds_bucket{path=~\"$path\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3C6EB4" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#7EB0F5" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C4DBFF" } }]
          }
        ]
      }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Traffic shape — asked for vs delivered",
      "description": "The dashed line is what the configured shape is asking for; the solid line is what actually completed. They diverge when the target cannot keep up, which is the interesting case. Same unit, one axis.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "spoofy_target_rate",
          "legendFormat": "asked for"
        },
        {
          "refId": "B",
          "expr": "sum(rate(spoofy_requests_total[1m]))",
          "legendFormat": "delivered"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "asked for" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8E8E8E" } },
              {
                "id": "custom.lineStyle",
                "value": { "fill": "dash", "dash": [8, 6] }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "delivered" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } },
              { "id": "custom.fillOpacity", "value": 14 }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Requests by endpoint",
      "description": "Templated paths, never concrete URLs — that is what keeps Prometheus cardinality bounded over a long run. Colour is assigned from the series name, so filtering does not repaint the survivors.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(spoofy_requests_total{path=~\"$path\"}[1m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "description": "Where the slow endpoint lives. In the bundled demo API, /pets/{petId}/photos is deliberately the slow one.",
      "datasource": { "type": "prometheus", "uid": "spoofy-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(spoofy_request_duration_seconds_bucket{path=~\"$path\"}[5m])))",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    }
  ]
}
